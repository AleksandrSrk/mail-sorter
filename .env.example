# Ящики и пароли одной строкой в JSON: {"адрес": "пароль", ...}
MAILBOXES={"info@example.ru": "password1", "sales@example.ru": "password2"}

IMAP_HOST=imap.example.ru
IMAP_PORT=993
SMTP_HOST=smtp.example.ru
SMTP_PORT=465

# Как часто проходить по ящикам, секунд
POLL_INTERVAL=60

# Уведомления о сбоях: с какого ящика (из MAILBOXES) и куда слать
NOTIFY_FROM=info@example.ru
NOTIFY_TO=admin@example.com
# Не чаще одного письма об одной и той же ошибке, секунд
NOTIFY_COOLDOWN=3600
