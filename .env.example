# Ящики и пароли одной строкой в JSON: {"адрес": "пароль", ...}
MAILBOXES={"info@example.ru": "password1", "sales@example.ru": "password2"}

IMAP_HOST=imap.example.ru
IMAP_PORT=993
SMTP_HOST=smtp.example.ru
SMTP_PORT=465

# Как часто проходить по ящикам, секунд
POLL_INTERVAL=60
# Час (локальное время контейнера, TZ), когда раз в сутки делается полный проход по всем письмам
FULL_SCAN_HOUR=3

# Telegram-бот: ошибки, отписки и управление спам-фильтром. Отвечает только TG_ADMIN_ID.
TG_BOT_TOKEN=123456:ABC-replace-me
TG_ADMIN_ID=123456789
# Не чаще одного сообщения об одной и той же ошибке, секунд
NOTIFY_COOLDOWN=3600
# Сколько дней без писем после отписки, чтобы снять адрес со спам-фильтра
UNSUB_QUIET_DAYS=7
